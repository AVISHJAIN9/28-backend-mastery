# Stream Internals & Backpressure - Environment Variables

# Server Configuration
HTTP_PORT=3022
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Stream Settings
DEFAULT_HIGH_WATER_MARK=16384
OBJECT_MODE=false
STREAM_ENCODING=utf8

# Backpressure
ENABLE_BACKPRESSURE_HANDLING=true
DRAIN_TIMEOUT=5000
