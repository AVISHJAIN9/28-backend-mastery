# Event Loop Module - Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development
HOST=localhost

# Event Loop Monitoring
EVENT_LOOP_MONITOR_ENABLED=true
EVENT_LOOP_SAMPLE_INTERVAL=1000
EVENT_LOOP_LAG_THRESHOLD=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Performance
MAX_REQUEST_SIZE=10mb
TIMEOUT=30000

# Profiling
PROFILE_ENABLED=false
PROFILE_INTERVAL=60000

