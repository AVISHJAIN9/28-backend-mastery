# Server Configuration
HTTP_PORT=6105
NODE_ENV=development

# Use Mock Gateways (without real credentials)
USE_MOCK_GATEWAYS=true

# Razorpay Configuration (Optional)
# Get from: https://razorpay.com/dashboard
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# PayU Configuration (Optional)
# Get from: https://payu.in/dashboard
# PAYU_MERCHANT_KEY=...
# PAYU_MERCHANT_SALT=...
