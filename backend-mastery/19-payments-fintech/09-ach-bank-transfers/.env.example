HTTP_PORT=6109\nJWT_SECRET=your_jwt_secret_key_here\n\n# Plaid Configuration\nPLAID_CLIENT_ID=your_plaid_client_id\nPLAID_SECRET=your_plaid_secret_key\nPLAID_ENV=sandbox\n\n# Database (optional)\nDB_URL=mongodb://localhost:27017/ach_transfers\n\n# Webhook\nWEBHOOK_VERIFY=true\nPLAID_WEBHOOK_SECRET=plaid_webhook_secret_token\n\n# Rate Limiting\nRATE_LIMIT_WINDOW_MS=3600000\nRATE_LIMIT_MAX_TRANSFERS=100\n