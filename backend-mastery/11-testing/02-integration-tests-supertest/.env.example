# Environment Configuration for Integration Testing Module

# Server Config
NODE_ENV=development
HTTP_PORT=5402
FRONTEND_URL=http://localhost:3000

# Database Config (Test)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=testing_integration_test
TEST_DB_USER=test_user
TEST_DB_PASSWORD=test_password

# API Config
API_TIMEOUT=5000
ENABLE_DB_LOGGING=false

# Test Config
TEST_CLEANUP=true
KEEP_TEST_DATA=false

