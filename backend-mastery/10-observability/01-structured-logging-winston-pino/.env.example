# Environment Configuration for Structured Logging Module

# Server Port
HTTP_PORT=4001

# Environment
NODE_ENV=development

# Logging Level (error, warn, info, debug, verbose, silly)
LOG_LEVEL=info

# Log Files Directory
LOG_DIR=./logs

# Max Log File Size (in bytes)
LOG_FILE_SIZE=5242880

# Max Log Files to Keep
LOG_FILES_MAX=5

