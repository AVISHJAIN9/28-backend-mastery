# Environment Configuration for Uptime Monitoring & SLAs Module

# Server Port
HTTP_PORT=4009

# Environment (development or production)
NODE_ENV=development

# Logging Level (error, warn, info, debug, verbose, silly)
LOG_LEVEL=info

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# SLO Configuration

# SLO Target (0.99 = 99%, 0.999 = 99.9%, 0.9999 = 99.99%)
SLO_TARGET=0.999

# Maximum allowed downtime per month in minutes
# For 99.9% uptime: 43 minutes/month
# For 99.99% uptime: 4.3 minutes/month
SLO_DOWNTIME_BUDGET=43

# Health Check Configuration

# How often to run health checks (milliseconds)
# 60000 = every minute
HEALTH_CHECK_INTERVAL=60000

# Alerting Thresholds

# Alert if error rate rises above this (0.05 = 5%)
ALERT_ERROR_RATE=0.05

# Alert if P95 latency exceeds this (milliseconds)
ALERT_P95_LATENCY=5000

# Alert if P99 latency exceeds this (milliseconds)
ALERT_P99_LATENCY=10000

# Metrics Retention

# Maximum number of requests to keep in memory
# Older requests are discarded to prevent memory leaks
MAX_REQUESTS_STORED=10000

# Maximum number of incidents to keep
MAX_INCIDENTS_STORED=500

# Summary Calculation

# How many days back to consider as "recent" for incident summary
INCIDENT_SUMMARY_DAYS=7

