# ==================== Server Configuration ====================
HTTP_PORT=4002
NODE_ENV=development

# ==================== Queue Configuration ====================
# Queue provider: memory, redis, bull
QUEUE_PROVIDER=memory

# Redis Configuration (if QUEUE_PROVIDER=redis or bull)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== Email Provider (for actual sending) ====================
EMAIL_PROVIDER=nodemailer
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@app.local

# ==================== Retry Configuration ====================
# Backoff strategy: exponential, linear, fixed
DEFAULT_BACKOFF_STRATEGY=exponential
DEFAULT_MAX_ATTEMPTS=5
DEFAULT_BASE_DELAY_MS=5000
MAX_DELAY_MS=3600000

# ==================== Bounce Handling ====================
VERIFY_WEBHOOKS=false
BOUNCE_WEBHOOK_SECRET=your-webhook-secret

# ==================== Monitoring ====================
LOG_LEVEL=info
AUDIT_ENABLED=true

# ==================== Security ====================
JWT_SECRET=your-jwt-secret-key
FRONTEND_URL=http://localhost:3000

