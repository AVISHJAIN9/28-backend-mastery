# Feature Flags Module Environment Variables

# Port for Express server
HTTP_PORT=4004

# Environment
NODE_ENV=development

# Feature Flag Service
# Options: 'database' (in-memory), 'launchdarkly', 'custom'
FLAG_SERVICE=database

# Optional: LaunchDarkly SDK key (if using LaunchDarkly)
# LAUNCHDARKLY_SDK_KEY=your_sdk_key_here

# Optional: Database connection (if persisting flags)
# DATABASE_URL=mongodb://localhost:27017/feature_flags

# Feature flag defaults
DEFAULT_ROLLOUT_PERCENTAGE=0
DEFAULT_FLAG_ENABLED=true

# Caching
CACHE_TTL_SECONDS=60
ENABLE_REDIS=false
# REDIS_URL=redis://localhost:6379

# Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true

# Feature flag audit
ENABLE_AUDIT_LOG=true
AUDIT_LOG_RETENTION_DAYS=30
