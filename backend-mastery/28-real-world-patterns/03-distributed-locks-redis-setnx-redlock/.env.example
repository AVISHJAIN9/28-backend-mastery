# Distributed Locks Module Configuration

# Server Port
HTTP_PORT=4003

# Node Environment
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redlock Configuration
# Number of Redis instances for Redlock (use 1 for single instance, 3+ for fault tolerance)
REDLOCK_INSTANCES=1

# Lock TTL (in milliseconds)
# Default: 10000 (10 seconds)
# Increase if operations take longer
DEFAULT_LOCK_TTL=10000

# Lock Retry Configuration
LOCK_MAX_RETRIES=3
LOCK_RETRY_DELAY=200

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Features
ENABLE_VULNERABLE_ENDPOINTS=true
ENABLE_ADVANCED_FEATURES=true
