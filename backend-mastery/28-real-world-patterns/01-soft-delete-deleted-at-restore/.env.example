# Soft Delete Pattern - Environment Variables

# Server Configuration
NODE_ENV=development
HTTP_PORT=4001
REACT_PORT=3001

# Logging
LOG_LEVEL=info

# Database (if using PostgreSQL or MongoDB)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_NAME=soft_delete_db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Feature Flags
ENABLE_HARD_DELETE=false
ENABLE_AUDIT_LOGGING=true

# Retention Policy (in days)
RETENTION_DAYS=90
AUTO_HARD_DELETE_ENABLED=false

# API Configuration
API_BASE_URL=http://localhost:4001/api
API_TIMEOUT=30000

# Security
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# Monitoring (optional)
# SENTRY_DSN=
# DD_TRACE_ENABLED=false

# Email (for notifications)
# MAIL_SERVICE=
# MAIL_USER=
# MAIL_PASSWORD=

# Slack (for alerts)
# SLACK_WEBHOOK_URL=

# Feature Flags
# FEATURE_USER_SOFT_DELETE=true
# FEATURE_USER_RESTORE=true
# FEATURE_AUDIT_TRAIL=true

# Cache Configuration
# CACHE_ENABLED=true
# CACHE_TTL=3600

# Performance
# ENABLE_QUERY_LOGGING=true
# SLOW_QUERY_THRESHOLD=1000

