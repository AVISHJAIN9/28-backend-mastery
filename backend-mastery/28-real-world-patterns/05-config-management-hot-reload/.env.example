# Configuration Management & Hot-Reload Module
# Copy this file to .env and update for your environment

# Environment mode (development, staging, production)
NODE_ENV=development

# Server configuration
HTTP_PORT=4005
HOST=localhost

# Database configuration
DATABASE_URL=mongodb://localhost/config_demo
DB_POOL_SIZE=10
DB_TIMEOUT=5000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Application configuration (these can be hot-reloaded)
API_TIMEOUT=5000
CACHE_TTL=600
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60000

# Feature flags
FEATURES_ENABLED=checkout,payments,analytics

# Security
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:3000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Development only
DEBUG=false
MOCK_DATABASE=true
