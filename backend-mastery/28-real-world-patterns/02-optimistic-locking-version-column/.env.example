# Optimistic Locking Pattern - Environment Variables

# Server Configuration
NODE_ENV=development
HTTP_PORT=4002
REACT_PORT=3002

# Logging
LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3000

# Optimistic Locking Config
MAX_RETRIES=3
RETRY_BACKOFF_MS=100

# Feature Flags
ENABLE_CONFLICT_LOGGING=true
ENABLE_CONFLICT_METRICS=true

# Database (optional)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=optimistic_locking

