# Module 09: Graceful Degradation - Environment Variables

# Server Configuration
HTTP_PORT=4009
NODE_ENV=development

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGINS=http://localhost:3000

# Circuit Breaker Defaults (can be overridden per service)
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_TIMEOUT_MS=5000
CIRCUIT_RESET_TIMEOUT_MS=30000
