# Seeding & Fixtures Module
# Copy this file to .env and update for your environment

# Environment mode (development, staging, production)
NODE_ENV=development

# Server configuration
HTTP_PORT=4006
HOST=localhost

# Database configuration
DATABASE_URL=mongodb://localhost/seeding_demo
DB_POOL_SIZE=10
DB_TIMEOUT=5000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Seeding configuration
BATCH_SIZE=100
FAKER_SEED=12345
DEFAULT_LOCALE=en_US
MAX_RECORDS=100000

# Collections to seed
COLLECTIONS=users,posts,comments,tags

# Fixture paths
FIXTURE_PATH=./fixtures
FIXTURE_HISTORY=./fixture-history.json

# Feature flags
AUTO_SEED_ON_START=false
VALIDATE_AFTER_SEED=true
CLEAN_BEFORE_SEED=false
ENABLE_PARALLEL_SEEDING=true

# Development only
DEBUG=false
MOCK_DATABASE=true
