# Server Configuration
HTTP_PORT=5406
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_FILE=combined.log

# DST Configuration
DST_AWARE=true
TIMEZONE_DATABASE_UPDATE=yearly

# Supported Timezones with DST
SUPPORTED_TIMEZONES=UTC,America/New_York,America/Los_Angeles,America/Denver,America/Chicago,Europe/London,Europe/Paris,Europe/Berlin,Asia/Tokyo,Australia/Sydney

# Cron Job Configuration for DST
CRON_TIMEZONE=America/New_York
