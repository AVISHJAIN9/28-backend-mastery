# Server Configuration
HTTP_PORT=5401
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_FILE=combined.log

# JWT Secret (if needed)
JWT_SECRET=your_jwt_secret_key_here

# Supported Timezones (comma-separated)
SUPPORTED_TIMEZONES=UTC,America/New_York,America/Los_Angeles,Europe/London,Europe/Paris,Asia/Tokyo,Australia/Sydney,Asia/Kolkata
