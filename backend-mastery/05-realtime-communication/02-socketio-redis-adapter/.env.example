# Redis Socket.io Adapter Configuration

PORT=4000
SERVER_ID=server_1
NODE_ENV=production

CLIENT_URL=http://localhost:3000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Socket.io Configuration
SOCKET_AUTO_RECONNECT=true
SOCKET_RECONNECT_DELAY=1000
SOCKET_RECONNECT_ATTEMPTS=5

# Monitoring
ENABLE_METRICS=true
LOG_LEVEL=info

