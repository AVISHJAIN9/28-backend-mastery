# LDAP Configuration

# LDAP Server
LDAP_URL=ldap://ldap.example.com:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-admin-password

# Active Directory (alternative)
AD_URL=ldap://dc01.company.local:389
AD_BASE_DN=dc=company,dc=local
AD_DOMAIN=COMPANY

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_TOKEN_EXPIRY=86400
SESSION_REFRESH_INTERVAL=3600

# Logging
LOG_LEVEL=debug
ENABLE_AUDIT_LOG=true

# Database (optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ldap_auth_db
DB_USER=postgres
DB_PASSWORD=password

# Features
ENABLE_USER_SEARCH=true
ENABLE_PASSWORD_RESET=false
ENABLE_MFA=false
