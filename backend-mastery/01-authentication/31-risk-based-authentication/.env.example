JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
PORT=3000

# Risk Assessment
RISK_HIGH_THRESHOLD=0.4
RISK_CRITICAL_THRESHOLD=0.7
MFA_REQUIRED_ABOVE_RISK=0.4

# Geographic Risk
HIGH_RISK_COUNTRIES=KP,IR,SY
IMPOSSIBLE_TRAVEL_THRESHOLD=60

# Device Management
NEW_DEVICE_RISK_SCORE=0.6
DEVICE_TRUST_DECAY=0.05

# Monitoring
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_HOURS=24
UNIQUE_IP_THRESHOLD=5
