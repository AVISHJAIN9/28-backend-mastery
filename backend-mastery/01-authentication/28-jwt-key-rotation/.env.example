# JWT Key Rotation Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_ALGORITHM=RS256
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=auth-service
JWT_AUDIENCE=api

# Key Rotation Policy
KEY_ROTATION_INTERVAL=86400000
DEPRECATED_KEY_GRACE_PERIOD=86400000
MAX_KEY_AGE=7776000000

# Database (optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jwt_rotation_db
DB_USER=postgres
DB_PASSWORD=password

# Logging
LOG_LEVEL=debug
ENABLE_AUDIT_LOG=true

# Key Storage (filesystem path for demonstration)
KEY_STORAGE_PATH=./keys
