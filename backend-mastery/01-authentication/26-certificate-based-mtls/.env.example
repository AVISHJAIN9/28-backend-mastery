# mTLS Configuration
PORT=3443
NODE_ENV=development

# TLS Certificate paths for server
TLS_KEY_PATH=./certs/server-key.pem
TLS_CERT_PATH=./certs/server-cert.pem

# Client CA certificate
CLIENT_CA_PATH=./certs/client-ca-cert.pem

# mTLS Settings
MTLS_ENABLED=true
MTLS_STRICT=true
CERTIFICATE_REQUIRED=true

# Session configuration
SESSION_TOKEN_EXPIRY=86400
SESSION_REFRESH_INTERVAL=3600

# Certificate revocation list (CRL) path (optional)
CRL_PATH=./certs/crl.pem

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mtls_auth_db
DB_USER=postgres
DB_PASSWORD=password

# Logging
LOG_LEVEL=debug
ENABLE_AUDIT_LOG=true

# Admin settings
ADMIN_CLIENT_THUMBPRINT=your-admin-cert-thumbprint
