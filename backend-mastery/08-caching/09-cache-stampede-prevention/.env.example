# Environment variables for Module 09: Cache Stampede Prevention

# Server Configuration
NODE_ENV=development
HTTP_PORT=6415

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Caching Parameters
CACHE_TTL=60
CACHE_MAXSTALE=20

# XFetch Configuration (probabilistic early refresh)
XFETCH_DELTA=10

# Lock Configuration (distributed lock coordinator)
LOCK_TTL=10000
LOCK_TIMEOUT=5000

# Stale-While-Revalidate Configuration
STALE_WINDOW=20

# Logging
LOG_LEVEL=debug
