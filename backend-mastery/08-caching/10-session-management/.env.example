# Environment variables for Module 10: Session Management

# Server Configuration
NODE_ENV=development
HTTP_PORT=6416

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Session Parameters
SESSION_TTL=1800
IDLE_TIMEOUT=900
MAX_SESSION_AGE=28800

# Logging
LOG_LEVEL=debug
